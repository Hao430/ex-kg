# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Spec D3 邮箱验证（Nodemailer）---
# 四项 SMTP_* 全部配置时走真实 SMTP；任一缺失则进入 jsonTransport 干跑模式
# （邮件仅写入内存 outbox 并在服务端日志打印验证链接）。
# 开发环境推荐 Mailpit：docker run -p 8025:8025 -p 1025:1025 axllent/mailpit，
# 将 SMTP_HOST 指向 localhost、SMTP_PORT 指向 1025，即可在 http://localhost:8025 查收邮件。
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""

# --- 在线支付开关 ---
# 在线充值接口总开关（POST /api/subscriptions/orders 及 mock-pay）：
# false 时一律返回 503 PAYMENT_DISABLED；true 时按下方 ALIPAY_* 配置选择支付渠道——
# 三要素齐备走支付宝真实收银台，否则回落 mock 模拟渠道（开发/测试用）。
# 注意：npm test 会自动以 PAYMENT_ENABLED=true 运行，无需手动设置。
PAYMENT_ENABLED="false"

# --- 支付宝电脑网站支付（ADR-0014，alipay.trade.page.pay）---
# 三项全部配置后自动启用支付宝渠道；任一缺失回落 mock 渠道。
# ALIPAY_APP_ID：开放平台应用 AppId
# ALIPAY_PRIVATE_KEY：应用私钥（PKCS8，单行 base64 即可，无需 PEM 头尾）
# ALIPAY_ALIPAY_PUBLIC_KEY：支付宝公钥（开放平台「接口加签方式」里的支付宝公钥，
#   不是商户应用公钥！沙箱与生产的公钥不可混用，否则异步通知验签必失败）
# ALIPAY_GATEWAY：可选，默认正式环境 https://openapi.alipay.com；
#   沙箱填 https://openapi-sandbox.dl.alipaydev.com
# 异步通知地址由 APP_URL 推导（{APP_URL}/api/subscriptions/notify），须公网可达。
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_ALIPAY_PUBLIC_KEY=""
ALIPAY_GATEWAY=""

# --- Spec K4（跟踪清单 B3）：Umami 自托管埋点 ---
# 部署：docker compose -f docker-compose.umami.yml up -d（独立 3001 端口）
# 两项都配置后前端自动注入统计脚本并上报 K4 十事件；任一留空则埋点完全关闭。
# 注意：VITE_ 前缀变量会被打包进前端产物；website id 非敏感可公开，但勿放 APP_SECRET 等
VITE_UMAMI_SRC=""
VITE_UMAMI_WEBSITE_ID=""

# --- ADR-0017 画布节点级合并：旧写路径熔断开关 ---
# 服务端按请求体的 protocolVersion 分流：缺失 = 旧客户端的整板替换，>= 2 = 节点级合并。
# 默认（未设置或非 "false"）双路径并存，老客户端零中断。
# 客户端全面切到 protocolVersion:2、soaker ≥7 天后设为 "false"：
# 此后旧 payload 一律 409 CLIENT_OUTDATED（刻意不带 latest_updated_at，否则旧客户端
# 会进入「刷新版本号后重发」的循环）。翻之前必须有当日 pg_dump —— 一旦有用户用新语义
# 写入，翻回旧语义会让「未带 = 保留」的节点在新客户端的整板 payload 里被删掉。
SAVE_LEGACY_REPLACE_ENABLED="true"

# --- ADR-0018 默认画板私有化：授权放行开关 ---
# legacy（默认）= default-board 仍是全局共享单行，所有登录用户读写同一行（历史行为）。
# private = 授权路径不再有任何放行，默认板退化为「首个认领者的普通画板」；未认领 = 行不存在。
# 发布顺序**必须客户端先行**：客户端先改成「不可访问则建新板」并 soak ≥7 天，再翻本开关，
# 否则窗口期内非属主的旧标签页会在保存时 403。翻之前必须有当日 pg_dump——翻回 legacy 会让
# 私有默认板里的内容「消失」（改为读写共享行）。无论哪种模式，default-board 都不允许删除。
SAVE_DEFAULT_BOARD_MODE="legacy"

# --- ADR-0017 画布墓碑 GC：保留期（天，默认 30） ---
# 合并写入把「删除」记成软删墓碑（nodes/edges 的 deleted_at），日清任务按此保留期回收。
# 30 天对齐 ADR-0005 的软删冷却口径，且远大于 sync-queue 的退避上限，正常在线的设备不会
# 拖到那时还没把删除传上来。填 0 表示全部回收（运维一键清空用），请勿在生产随手设 0：
# 保留期为 0 时，超过一次 GC 周期没联网的设备仍持有旧节点，会把它们复活。
CANVAS_TOMBSTONE_RETENTION_DAYS="30"

# --- ADR-0019 数据库角色分离（三连接串）---
# 三个角色对应三种权限；未配置 DATABASE_URL 即进入内存回退模式（ADR-0002）。
#
# DATABASE_URL：运行期主体，登录角色 arborize_app（DML-only，**受行级安全 RLS 约束**）。
#   所有租户内请求都走它。生产翻到 arborize_app 之前，RLS 策略对其**不生效**。
DATABASE_URL="postgres://arborize_app:CHANGE_ME@127.0.0.1:5432/arborize"
#
# DATABASE_SYSTEM_URL：跨租户路径，登录角色 arborize_system（DML + BYPASSRLS）。
#   用于「登录前还不知道是谁」的路径（按 token 查会话、按 email 查用户、匿名分享、支付宝回调、
#   日清任务、admin 运营台聚合、可观测写入）。缺省回落 DATABASE_URL——但**生产必须显式配置**：
#   回落会让这些路径以 arborize_app 执行并被 RLS 拦成零行，表现为「所有人登录失效」。
#   启动时 checkRuntimeDbRoleInvariants() 会拒绝在缺它的情况下启动。
#   权限边界要认清：持有本串者可读全库（仍不能 DDL）。RLS 的价值是兜住应用层漏写属主过滤的
#   bug，不是抵御已持有高权限凭据的攻击者。
DATABASE_SYSTEM_URL="postgres://arborize_system:CHANGE_ME@127.0.0.1:5432/arborize"
#
# DATABASE_ADMIN_URL：表属主 syf_minapp（全部权限 + DDL）。
#   ⚠️ **不得写入运行期 .env**——生产环境一旦出现，checkRuntimeDbRoleInvariants() 会拒绝启动。
#   它只由部署期 `npm run migrate` 步骤经临时 env 文件注入（见 .github/workflows/ci.yml），
#   本地开发用 `npm run migrate:dev`。
#   本地开发若只配了 DATABASE_URL，migrate 会回落使用它（受限角色跑 DDL 会失败，属预期）。
# DATABASE_ADMIN_URL="postgres://syf_minapp:CHANGE_ME@127.0.0.1:5432/arborize"

# --- 微信开放平台「网站应用」扫码登录（ADR-0022）---
# 两项都配置后才启用微信登录：
#   - 前端会渲染「微信扫码登录」入口（GET /api/auth/wechat/status 返回 enabled:true）；
#   - 缺任一 → 入口不渲染、/authorize 直接 302 回 /?wechat_error=NOT_CONFIGURED（绝不半死）。
# WECHAT_APP_ID：开放平台「网站应用」的 AppID（须已通过微信登录审核）。
# WECHAT_APP_SECRET：应用密钥，**运行期专用**——不要加 VITE_ 前缀（那会把密钥打进前端产物）。
# 回调地址**不单设变量**，由 APP_URL 推导为 {APP_URL}/api/auth/wechat/callback；
# 开放平台后台的「授权回调域」必须登记为 APP_URL 的域名（只能填域名、不能带路径，
# 与 APP_URL 不一致时表现为「该链接无法访问」）。改完必须重启进程。
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
