{
  "name": "arborize",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server/core/migrate-cli.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/migrate.cjs",
    "start": "node dist/server.cjs",
    "migrate": "node dist/migrate.cjs",
    "migrate:dev": "tsx server/core/migrate-cli.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "PAYMENT_ENABLED=true tsx --test 'tests/*.test.ts'",
    "arch:check": "depcruise . --config .dependency-cruiser.cjs",
    "arch:check:html": "depcruise . --config .dependency-cruiser.cjs --output-type html --output-to arch-report.html",
    "arch:check:graph": "depcruise . --config .dependency-cruiser.cjs --output-type dot --output-to arch-graph.dot",
    "arch:test": "tsx --test 'arch-tests/*.test.mjs'",
    "arch:all": "npm run arch:check && npm run arch:test"
  },
  "dependencies": {
    "@antv/hierarchy": "^0.7.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.6",
    "alipay-sdk": "^4.14.0",
    "cookie-parser": "^1.4.7",
    "dagre": "^0.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "html-to-image": "1.11.11",
    "jsonrepair": "^3.15.0",
    "katex": "^0.18.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^6.2.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "dependency-cruiser": "^18.3.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
